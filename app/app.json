{
  "expo": {
    "name": "ThuocTracker",
    "slug": "thuoctracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.hackpsu.thuoctracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "edu.hackpsu.thuoctracker",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan medicine labels."
        }
      ],
      [
        "react-native-auth0",
        {
          "domain": "dev-igr7vxhgin21kqfz.us.auth0.com"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a24422f3-b819-41c1-a63f-7f79e6381b52"
      }
    },
    "owner": "minhdeptraivcl"
  }
}
