# Copy to pi/.env on the Pi (pi/setup.sh does). Read by cabinet.service and kiosk.sh.
BACKEND_URL=http://192.168.137.1:8000
# The patient whose doses this Pi's doors and speaker handle. Sign the screen in as the same patient.
PATIENT_ID=1
# esp32: speaker and mic are on the ESP32-S3 audio unit (pi/esp32/README.md). Unset: the Pi's own audio.
AUDIO=esp32
# Parts not wired yet. Remove each one as Duy connects it; empty = all real.
MOCK=servo,audio
