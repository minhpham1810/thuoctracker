(text "THUOCTRACKER  /  CABINET WIRING" (at 175 16 0) (effects (font (size 2.6 2.6)) (justify left top)) (uuid dfb765cd-6d93-41bc-bfcb-c106a4dd20d5))
(text "Manual drawers  |  5-inch display  |  Pi + ESP32" (at 175 23 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 8b01b0cb-aded-448b-93b3-baf95479d1f7))
(text "USB-A to USB-C DATA cable\nPowers Feather; two serial interfaces" (at 105 31 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid f152af8c-fb7e-45e2-9a98-9c40a76efdaa))
(text "Supplied Pi 5 DSI ribbon + factory power interface.\nCable bundles above are not individual connector pins." (at 175 70 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid e7604574-05c9-4a6f-8904-f1e9fea5816b))
(text "Speaker terminals float.\nDo not connect either to GND.\nStart at low volume (0.5 W speaker)." (at 292 146 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid 27a05193-f69c-4311-8d0b-9e2c1eb181ea))
(text "Place C1 directly across amp VIN/GND.\nKeep amp +5 V separate from Pi/Feather +5 V.\nAll GND labels are connected together." (at 292 186 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid dfd2a8b7-a8c3-4e31-831b-a157a522341b))
(text "INMP441 L/R -> GND selects left channel.\nEncoder + -> 3V, never the amp 5 V rail.\nAmp SD / GAIN: retain working breakout defaults." (at 292 213 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid 8fe45ae1-33b5-4f3e-a5c7-39821899e7ef))
(text "WIRING KEY\nGreen wires and matching net names connect.\nModule symbols show breakout terminal labels;\nthese are not bare-IC package pin numbers." (at 15 263 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid ddbedbbf-8c49-4859-91be-41b59c767317))
(text "FRONT PANEL\nEncoder: left, 14.5 mm opening.\nSpeaker: right, rim held by plywood ring.\nPi/display below; Feather/audio above." (at 165 263 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid 29fabd69-4bf7-43ad-9202-6bd2867f3d96))
(text "ASSEMBLY\nShort I2S leads; strain-relieve connectors.\nNo motor or position sensor in this build." (at 292 248 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid d45e3fe8-9334-4534-bdc9-85af42730204)))
