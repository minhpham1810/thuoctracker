GEMINI_API_KEY=
ELEVENLABS_API_KEY=
DEMO=1
# Tiger Data (Postgres) service URL
DATABASE_URL=
# Voice questions: Ollama on an Apple Silicon Mac (default http://localhost:11434)
# OLLAMA_URL=http://<mac-ip>:11434
# Label scanning: a local vision model on Ollama (Windows or Mac). Default: first installed of gemma4,
# qwen2.5vl, llama3.2-vision, minicpm-v, llava. No Ollama on this laptop -> Gemini.
# OLLAMA_VISION_MODEL=gemma4:e4b
# Not a Mac (Windows/Linux, NVIDIA GPU): the non-MLX model, which also hears audio
# OLLAMA_MODEL=gemma4:e4b
